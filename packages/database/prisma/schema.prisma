// FotoProy — Prisma schema (source of truth of the data model).
//
// Notes:
// - MVP-oriented modeling per SPEC §5 (docs/SPEC.md). The original DDL in the
//   SPEC is informative: this schema is the canonical version.
// - Decision F0.4: coordinates are stored as Decimal (lat/lng) instead of
//   GEOMETRY(Point,4326). PostGIS stays enabled on the local DB (docker) for
//   future use (live maps, geofencing) without needing to migrate types.
// - Table names in plural snake_case (@@map); column names in camelCase
//   (Prisma convention).
// - Every entity created on the mobile app arrives with its own client-side
//   UUID v4 (idempotency).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  SUPERVISOR
  TECHNICIAN
}

enum PlanKind {
  IMAGE
  PDF
}

enum MediaKind {
  PHOTO
  VIDEO
}

// ---------------------------------------------------------------------------
// Organizations / companies (B2B customers)
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  taxId     String?  @unique // RUC / NIT / RFC (optional in MVP)
  legalName String
  tradeName String?
  createdAt DateTime @default(now())

  users    User[]
  projects Project[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Users & roles
// ---------------------------------------------------------------------------

model User {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String        @unique
  passwordHash   String
  fullName       String
  /** Short professional signature burned on photos (initials / nickname). */
  signature      String?
  role           Role          @default(TECHNICIAN)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())

  photos       Photo[]
  comments     PhotoComment[]
  createdPins  PhotoPin[]      @relation("PinsByUser")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Projects / construction sites
// ---------------------------------------------------------------------------

model Project {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  clientName     String?
  latitude       Decimal?     @db.Decimal(10, 7) // Center location (optional)
  longitude      Decimal?     @db.Decimal(10, 7)
  createdAt      DateTime     @default(now())

  plans  ProjectPlan[]
  photos Photo[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("projects")
}

// ---------------------------------------------------------------------------
// Project plans / site maps (image or multi-page PDF)
// ---------------------------------------------------------------------------

model ProjectPlan {
  id                   String    @id @default(uuid())
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                String
  storageKey           String // R2 object key of the uploaded plan file
  thumbnailStorageKey  String? // R2 object key of the generated JPEG thumbnail (IMAGE plans)
  pageCount            Int       @default(1)
  planKind             PlanKind  @default(IMAGE)
  createdAt            DateTime  @default(now())

  pins PhotoPin[]

  @@index([projectId])
  @@map("project_plans")
}

// ---------------------------------------------------------------------------
// Photos
// ---------------------------------------------------------------------------

model Photo {
  id                   String    @id
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId               String?
  user                 User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind                 MediaKind @default(PHOTO)
  durationMs           Int? // Video duration in ms (kind VIDEO)
  storageKey           String // R2 object key of the original media
  thumbnailStorageKey  String? // R2 object key of the generated WebP thumbnail
  latitude             Decimal?  @db.Decimal(10, 7) // Device GPS (optional)
  longitude            Decimal?  @db.Decimal(10, 7)
  altitude             Decimal?  @db.Decimal(8, 2)
  notes                String?
  capturedAt           DateTime // Client timestamp (may drift while offline)
  syncedAt             DateTime  @default(now()) // Server timestamp

  pins     PhotoPin[]
  comments PhotoComment[]

  @@index([projectId, capturedAt])
  @@index([userId])
  @@map("photos")
}

// ---------------------------------------------------------------------------
// Pins: photo anchored over a plan (relative position per page)
// ---------------------------------------------------------------------------

model PhotoPin {
  id          String       @id
  planId      String
  plan        ProjectPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  photoId     String
  photo       Photo        @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?        @relation("PinsByUser", fields: [createdById], references: [id], onDelete: SetNull)
  pageNumber  Int          @default(1)
  xPercentage Decimal      @db.Decimal(5, 2) // 0.00 – 100.00
  yPercentage Decimal      @db.Decimal(5, 2)
  createdAt   DateTime     @default(now())

  @@index([planId])
  @@index([photoId])
  @@map("photo_pins")
}

// ---------------------------------------------------------------------------
// Photo comments
// ---------------------------------------------------------------------------

model PhotoComment {
  id        String   @id
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([photoId, createdAt])
  @@map("photo_comments")
}
