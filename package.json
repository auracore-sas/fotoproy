{
  "name": "fotoproy",
  "version": "0.1.0",
  "private": true,
  "description": "FotoProy — construction project photo documentation (offline-first, mobile iOS + Android)",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "pnpm --filter @fotoproy/api dev",
    "dev:mobile": "pnpm --filter @fotoproy/mobile start",
    "dev:up": "bash scripts/dev-up.sh",
    "dev:stop": "bash scripts/dev-stop.sh",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @fotoproy/database db:migrate",
    "db:generate": "pnpm --filter @fotoproy/database db:generate",
    "db:studio": "pnpm --filter @fotoproy/database db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
