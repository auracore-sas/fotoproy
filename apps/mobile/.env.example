# Copy this file to `.env` and adjust values (`.env` is NOT committed).
# URL base de la API de FotoProy.
#   - Teléfono físico (Expo Go): usa la IP LAN de tu PC, p. ej. http://192.168.1.10:4100
#   - Emulador Android: http://10.0.2.2:4100
#   - iOS Simulator / web: http://localhost:4100
#   - PRODUCCIÓN: https://api.tudominio.com — se compila dentro del bundle, así que
#     cambiar la URL exige un build nuevo (ver docs/deployment.md §7).
EXPO_PUBLIC_API_URL=http://192.168.86.35:4100
