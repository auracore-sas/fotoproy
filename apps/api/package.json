{
  "name": "@fotoproy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FotoProy REST API (NestJS + Prisma + PostgreSQL)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
