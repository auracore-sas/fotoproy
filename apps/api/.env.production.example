# FotoProy API — PRODUCTION environment template.
#
# Copy to `apps/api/.env` on the server, or paste the same keys into the
# Dokploy application's Environment tab. The file is NOT committed (see
# .gitignore). Never paste these values into chat, tickets or logs.
#
# Dokploy step by step: docs/deployment.md §3.
# Default infrastructure for this project: Dokploy with MinIO + PostgreSQL
# already running on the same server (Traefik provides the domain and TLS).

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=4100

# ---------------------------------------------------------------------------
# Database (the PostgreSQL service already running in Dokploy)
# ---------------------------------------------------------------------------
# Use the INTERNAL connection URL shown by Dokploy for that service (a private
# Docker hostname). Create a dedicated database and user for FotoProy: Prisma
# creates its tables in the `public` schema.
DATABASE_URL="postgresql://fotoproy:CHANGE_ME@fotoproy-postgres-xxxx:5432/fotoproy?schema=public"

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Public domain of the API (Dokploy → Domains). No trailing slash.
PUBLIC_BASE_URL=https://fotoproy.apx5.com
# Browser origins allowed to call the API. The share pages are same-origin, so
# the public domain is enough. Keep '*' out.
CORS_ORIGIN=https://fotoproy.apx5.com

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Object storage — MinIO (already running in Dokploy)
# ---------------------------------------------------------------------------
# STORAGE_ENDPOINT is what the API container uses: the INTERNAL MinIO URL
# shown by Dokploy (http://<service>:9000).
# Use an alias WITHOUT underscores: MinIO validates the Host header and answers
# `400 InvalidRequest (invalid hostname)` for names like `minio_storage`, even
# when Docker resolves them.
# STORAGE_PUBLIC_ENDPOINT is what a phone can reach: give the MinIO service a
# domain in Dokploy (e.g. minio-api.apx5.com on the S3 API port 9000, HTTPS) and
# put it here. Pre-signed upload URLs are signed for that host; without it the
# phone cannot upload.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=https://minio-api.apx5.com
# MinIO accepts any region string, but it must match between requests.
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=CHANGE_ME
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
STORAGE_BUCKET=fotoproy
# MinIO requires path-style addressing.
STORAGE_FORCE_PATH_STYLE=true
# Signed URL validity (seconds). Lower = safer, higher = more tolerant with
# slow mobile networks. 3600 is a good default.
STORAGE_SIGNED_URL_TTL=3600

# Cloudflare R2 alternative (instead of MinIO):
#   STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   STORAGE_PUBLIC_ENDPOINT=            (empty: same endpoint is public)
#   STORAGE_REGION=auto
#   STORAGE_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Media processing
# ---------------------------------------------------------------------------
# Generate JPEG/WebP thumbnails on upload (sharp).
STORAGE_GENERATE_THUMBS=true
# Burn the evidence stamp (project · date · GPS · author · note) on photos.
STORAGE_STAMP_PHOTOS=true
# Strip EXIF/GPS metadata from stored photos (F4.5).
STORAGE_STRIP_EXIF=true

# ---------------------------------------------------------------------------
# Upload caps (F4.5) — megabytes. Shared constants are the app-side contract;
# these override them here without a rebuild (e.g. to match a CDN body limit).
# ---------------------------------------------------------------------------
UPLOAD_MAX_PHOTO_MB=25
UPLOAD_MAX_VIDEO_MB=200
UPLOAD_MAX_PLAN_MB=40

# ---------------------------------------------------------------------------
# Rate limiting (F4.5) — requests per window per client IP.
# Behind Cloudflare the client address comes from `CF-Connecting-IP`.
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=600
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_MEDIA_MAX=1200
RATE_LIMIT_TRUST_CF_HEADER=true

# Express `trust proxy`: keep false when Cloudflare provides the client IP.
TRUST_PROXY=false
JSON_BODY_LIMIT=1mb

# ---------------------------------------------------------------------------
# Migrations
# ---------------------------------------------------------------------------
# Applies `prisma migrate deploy` inside the container before the API starts
# (idempotent; a failure aborts the start). Set to false once you prefer to run
# migrations as a separate step.
RUN_MIGRATIONS_ON_START=true