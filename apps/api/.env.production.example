# FotoProy API — PRODUCTION environment template.
#
# Copy to `apps/api/.env` on the server and fill in the real values:
#   cp apps/api/.env.production.example apps/api/.env
#   chmod 600 apps/api/.env
#
# The file is NOT committed (see .gitignore). Never paste these values into
# chat, tickets or logs.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=4100

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Managed provider (Neon / Supabase / RDS) or the self-hosted container:
#   postgresql://USER:PASSWORD@db:5432/fotoproy?schema=public
# Add `?sslmode=require` when the provider requires TLS.
DATABASE_URL="postgresql://fotoproy:CHANGE_ME@db:5432/fotoproy?schema=public"

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Browser origins allowed to call the API. The share pages are same-origin, so
# the production value is normally just the public domain. Keep '*' out.
CORS_ORIGIN=https://api.tudominio.com

# Absolute base URL used to build read-only share links (F4.1). Must include
# the scheme and must NOT end with a slash.
PUBLIC_BASE_URL=https://api.tudominio.com

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Object storage — Cloudflare R2 (S3 API)
# ---------------------------------------------------------------------------
# R2 dashboard → R2 → API → Manage API tokens → create a token with
# "Object Read & Write" on the bucket. The endpoint is
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=CHANGE_ME
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
STORAGE_BUCKET=fotoproy
# R2 requires virtual-hosted style.
STORAGE_FORCE_PATH_STYLE=false
# Signed URL validity (seconds). Lower = safer, higher = more tolerant with
# slow mobile networks. 3600 is a good default.
STORAGE_SIGNED_URL_TTL=3600

# ---------------------------------------------------------------------------
# Media processing
# ---------------------------------------------------------------------------
# Generate JPEG/WebP thumbnails on upload (sharp).
STORAGE_GENERATE_THUMBS=true
# Burn the evidence stamp (project · date · GPS · author · note) on photos.
STORAGE_STAMP_PHOTOS=true
