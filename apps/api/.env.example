# Copy this file to `.env` and adjust values (`.env` is NOT committed).
NODE_ENV=development
PORT=4100
DATABASE_URL="postgresql://fotoproy:fotoproy@localhost:55432/fotoproy?schema=public"
# Allowed CORS origins (comma separated). '*' allows all.
CORS_ORIGIN=*
# JWT: replace in production with a strong random secret (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
