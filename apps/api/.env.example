# Copy this file to `.env` and adjust values (`.env` is NOT committed).
NODE_ENV=development
PORT=4100
DATABASE_URL="postgresql://fotoproy:fotoproy@localhost:55432/fotoproy?schema=public"
# Allowed CORS origins (comma separated). '*' allows all.
CORS_ORIGIN=*
# JWT: replace in production with a strong random secret (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Object storage (S3-compatible — MinIO in dev/Dokploy, Cloudflare R2 optional).
# Local dev values match docker-compose.yml (fotoproy-minio).
#
# Two endpoints may be needed:
#   STORAGE_ENDPOINT         what the API uses (internal Docker host is fine).
#   STORAGE_PUBLIC_ENDPOINT  what phones/browsers can reach. Pre-signed URLs
#                            are signed against this host, so in Dokploy set it
#                            to the public MinIO domain with HTTPS. Leave empty
#                            when one endpoint works for both.
#
# MinIO: STORAGE_FORCE_PATH_STYLE=true and any region string (us-east-1).
# Cloudflare R2: STORAGE_REGION=auto, STORAGE_FORCE_PATH_STYLE=false and
#   STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
# Example for Docker/Dokploy (swap for your public MinIO domain):
#   STORAGE_ENDPOINT=http://fotoproy-minio-xxxx:9000
#   STORAGE_PUBLIC_ENDPOINT=https://minio.minidominio.com
STORAGE_PUBLIC_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=fotoproy
STORAGE_SECRET_ACCESS_KEY=fotoproy-secret
STORAGE_BUCKET=fotoproy
STORAGE_FORCE_PATH_STYLE=true
# Signed URLs expiry (seconds).
STORAGE_SIGNED_URL_TTL=3600
# Generate WebP thumbnails automatically for uploaded photos (sharp).
STORAGE_GENERATE_THUMBS=true

# Burn an evidence stamp band (project/date/GPS/author) on stored photos.
STORAGE_STAMP_PHOTOS=true

# Public base URL for read-only share links (F4.1).
# In production set the real domain, e.g. https://fotoproy.apx5.com
# When empty, links are built from the incoming request (dev/LAN friendly).
PUBLIC_BASE_URL=
